{
  "name": "toss-cli",
  "version": "0.2.4",
  "description": "Share HTML artifacts with access-controlled links",
  "type": "module",
  "bin": {
    "toss": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "genversion": "node scripts/genversion.mjs",
    "build": "npm run genversion && tsc && rm -rf dist/templates && cp -r src/templates dist/templates && cp SKILL.md dist/SKILL.md",
    "build:bin": "./build.sh",
    "cli": "./toss",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "release": "npx --yes commit-and-tag-version",
    "release:patch": "npx --yes commit-and-tag-version --release-as patch",
    "release:minor": "npx --yes commit-and-tag-version --release-as minor",
    "release:major": "npx --yes commit-and-tag-version --release-as major"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
